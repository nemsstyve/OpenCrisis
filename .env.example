# ─── BASE DE DONNÉES ──────────────────────────────────────────────────────────
# En production Docker, "postgres" est le nom du service
DATABASE_URL="postgresql://opencrisis:changeme@postgres:5432/opencrisis"

# Variables utilisées directement par le service postgres
POSTGRES_USER=opencrisis
POSTGRES_PASSWORD=changeme
POSTGRES_DB=opencrisis

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Générer avec : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_GENERATE_A_RANDOM_64_BYTE_HEX_STRING
JWT_REFRESH_SECRET=CHANGE_ME_GENERATE_ANOTHER_RANDOM_64_BYTE_HEX_STRING

# Durée de vie des tokens
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── REDIS ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ─── APPLICATION ──────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4000

# Origine autorisée pour les requêtes CORS (URL publique du frontend)
CORS_ORIGIN=http://localhost

# ─── OPENCTI (optionnel) ──────────────────────────────────────────────────────
# Mettre OPENCTI_ENABLED=true uniquement si vous disposez d'une instance OpenCTI
OPENCTI_ENABLED=false
OPENCTI_URL=
OPENCTI_TOKEN=
