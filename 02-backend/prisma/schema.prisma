generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── IDENTITÉ & ACCÈS ─────────────────────────────────────────────────────────

// --- ISOLATION MULTI-TENANT ---

model Tenant {
  incidentIngestionMode IncidentIngestionMode @default(MANUAL)
  automaticCreationApproved Boolean @default(false)
  incidentProposals IncidentProposal[]
  wazuhConnectors WazuhConnector[]
  threatSubmissions ThreatSubmission[]
  incidentThreatLinks IncidentThreatLink[]

  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  incidents Incident[]
  documents Document[]
  roles     Role[]
  auditLogs AuditLog[]
  tags      Tag[]
  contacts  Contact[]
}

model User {
  reviewedIncidentProposals IncidentProposal[] @relation("IncidentProposalReviewer")

  tenantId           String?
  tenant             Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  id                 String    @id @default(uuid())
  email              String    @unique
  passwordHash       String
  firstName          String
  lastName           String
  phone              String?
  company            String?
  site               String?
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(false)
  sessionVersion     Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  roleAssignments RoleAssignment[]
  logEntries      LogEntry[]
  timelineEvents  TimelineEvent[]
  documents       Document[]
  contacts        Contact[]
  auditLogs       AuditLog[]
  refreshTokens   RefreshToken[]
  authSessions    AuthSession[]
  totpCredential TotpCredential?
  mfaAttemptBucket MfaAttemptBucket?
  createdIoCs     IoC[]

  @@index([deletedAt])
  @@index([isActive])
  @@index([tenantId])
}

model Role {
  tenantId    String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  id          String   @id @default(uuid())
  name        String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assignments RoleAssignment[]
  permissions RolePermission[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Permission {
  id       String             @id @default(uuid())
  resource PermissionResource
  action   PermissionAction

  rolePermissions RolePermission[]

  @@unique([resource, action])
}

model RoleAssignment {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

// Session d'authentification stable entre rotations JWT.
// Une revocation est individuelle, sans changer User.sessionVersion.
model AuthSession {
  id        String    @id @default(uuid())
  userId    String
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  user          User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  refreshTokens RefreshToken[]

  @@index([userId, revokedAt])
  @@index([expiresAt])
}


// Authentification multifacteur, un utilisateur = une configuration.
model MfaAttemptBucket {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  attempts  Int      @default(0)
  resetAt   DateTime
}

model TotpCredential {
  userId                  String   @id
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  secretCiphertext        String?
  pendingSecretCiphertext String?
  pendingExpiresAt        DateTime?
  enabledAt               DateTime?
  lastUsedStep            BigInt?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  recoveryCodes TotpRecoveryCode[]
}

// Seule l'empreinte du code est stockee.
// usedAt doit etre actualise atomiquement a l'utilisation.
model TotpRecoveryCode {
  id        String    @id @default(uuid())
  userId    String
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  credential TotpCredential @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId, usedAt])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  sessionId String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user    User         @relation(fields: [userId], references: [id])
  session AuthSession? @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([sessionId])
  @@index([expiresAt])
}

// ─── INCIDENT (WORKSPACE CENTRAL) ─────────────────────────────────────────────

model Incident {
  originatingProposal IncidentProposal?
  sharedThreatLinks IncidentThreatLink[]

  tenantId      String?
  tenant        Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  id            String         @id @default(uuid())
  name          String
  description   String?
  status        IncidentStatus @default(ACTIVE)
  severity      Severity       @default(MEDIUM)
  startedAt     DateTime       @default(now())
  resolvedAt    DateTime?
  createdById   String
  openctiCaseId String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?

  logEntries     LogEntry[]
  timelineEvents TimelineEvent[]
  documents      Document[]
  auditLogs      AuditLog[]

  @@index([status])
  @@index([deletedAt])
  @@index([createdById])
  @@index([tenantId])
}

// ─── MAIN COURANTE ────────────────────────────────────────────────────────────

model LogEntry {
  id         String    @id @default(uuid())
  incidentId String
  cell       Cell
  content    String
  authorId   String
  isEdited   Boolean   @default(false)
  editedAt   DateTime?
  editedById String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  incident Incident      @relation(fields: [incidentId], references: [id])
  author   User          @relation(fields: [authorId], references: [id])
  tags     LogEntryTag[]

  @@index([incidentId, cell, deletedAt])
  @@index([authorId])
  @@index([createdAt])
}

model Tag {
  id       String  @id @default(uuid())
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  name     String
  color    String  @default("#6B7280")

  logEntries LogEntryTag[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model LogEntryTag {
  logEntryId String
  tagId      String

  logEntry LogEntry @relation(fields: [logEntryId], references: [id])
  tag      Tag      @relation(fields: [tagId], references: [id])

  @@id([logEntryId, tagId])
}

// ─── TIMELINE ─────────────────────────────────────────────────────────────────

model TimelineEvent {
  id                String            @id @default(uuid())
  incidentId        String
  type              TimelineEventType
  title             String
  description       String?
  occurredAt        DateTime
  isFirstDetection  Boolean           @default(false)
  actorId           String?
  ipAddress         String?
  assetName         String?
  affectedUser      String?
  ioc               String?
  openctiEntityId   String?
  openctiEntityType String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  deletedAt         DateTime?

  incident  Incident   @relation(fields: [incidentId], references: [id])
  actor     User?      @relation(fields: [actorId], references: [id])
  documents Document[]
  iocs      IoC[]

  @@index([incidentId, occurredAt])
  @@index([deletedAt])
}

// ─── DOCUMENTS, BIBLIOTHÈQUE & ARTEFACTS ──────────────────────────────────────

model Document {
  tenantId          String?
  tenant            Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  id                String           @id @default(uuid())
  incidentId        String?
  timelineEventId   String?
  name              String
  filePath          String
  mimeType          String
  sizeBytes         Int
  category          DocumentCategory
  uploadedById      String
  openctiEntityId   String?
  openctiEntityType String?
  createdAt         DateTime         @default(now())
  deletedAt         DateTime?

  incident      Incident?      @relation(fields: [incidentId], references: [id])
  timelineEvent TimelineEvent? @relation(fields: [timelineEventId], references: [id])
  uploadedBy    User           @relation(fields: [uploadedById], references: [id])

  @@index([incidentId, deletedAt])
  @@index([uploadedById])
  @@index([tenantId, incidentId])
}

// ─── ANNUAIRE ─────────────────────────────────────────────────────────────────

model Contact {
  tenantId     String?
  tenant       Tenant? @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  id           String    @id @default(uuid())
  firstName    String
  lastName     String
  role         String
  organization String?
  phone        String?
  email        String?
  site         String?
  notes        String?
  createdById  String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  createdBy User @relation(fields: [createdById], references: [id])

  @@index([deletedAt])
  @@index([tenantId, deletedAt])
}

// ─── AUDIT LOG ────────────────────────────────────────────────────────────────

model AuditLog {
  tenantId   String?
  tenant     Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  id         String   @id @default(uuid())
  userId     String?
  action     String
  resource   String
  resourceId String?
  incidentId String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  user     User?     @relation(fields: [userId], references: [id])
  incident Incident? @relation(fields: [incidentId], references: [id])

  @@index([createdAt])
  @@index([userId])
  @@index([incidentId])
  @@index([resource, action])
  @@index([tenantId, createdAt])
}

// ─── ENUMS ────────────────────────────────────────────────────────────────────

enum IncidentStatus {
  ACTIVE
  CONTAINED
  CLOSED
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum Cell {
  DIRECTIONAL
  OPERATIONAL
  SHARED
}

enum TimelineEventType {
  DETECTION
  ACTION
  DECISION
  COMMUNICATION
  ESCALATION
  RESOLUTION
}

enum DocumentCategory {
  ARTIFACT
  FICHE_REFLEXE
  RAPPORT
  PROCEDURE
  OTHER
}

enum PermissionAction {
  READ
  WRITE
}

enum PermissionResource {
  DASHBOARD
  MAIN_COURANTE_DIR
  MAIN_COURANTE_OPS
  TIMELINE
  DOCUMENTS
  BIBLIOTHEQUE
  ANNUAIRE
  ADMIN
}

// --- INDICATEURS DE COMPROMISSION (IoC) ---

model IoC {
  id              String   @id @default(uuid())
  timelineEventId String
  type            IoCType
  value           String
  description     String?
  createdAt       DateTime @default(now())
  createdById     String

  timelineEvent TimelineEvent @relation(fields: [timelineEventId], references: [id], onDelete: Cascade)
  createdBy     User          @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([timelineEventId, createdAt])
  @@index([createdById])
}

enum IoCType {
  IPV4
  IPV6
  HASH_MD5
  HASH_SHA1
  HASH_SHA256
  DOMAIN
  URL
  EMAIL
  YARA
  OTHER
}


// Configuration de l'ingestion des alertes.
enum IncidentIngestionMode {
  MANUAL
  SEMI_AUTOMATIC
  AUTOMATIC
}

// Etat de traitement d'une proposition.
enum IncidentProposalStatus {
  PENDING
  APPROVED
  REJECTED
  CONVERTED
}

// Proposition issue d'une source externe authentifiee.
// Aucun payload brut d'alerte n'est stocke ici.
// Le tenant doit etre resolu cote serveur.
model IncidentProposal {
  id              String @id @default(uuid())
  tenantId        String
  tenant          Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  sourceType      String
  sourceId        String
  externalEventId String

  title           String
  description     String?
  severity        Severity
  status          IncidentProposalStatus @default(PENDING)

  reviewedById    String?
  reviewedBy      User? @relation("IncidentProposalReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  reviewedAt      DateTime?

  incidentId      String? @unique
  incident        Incident? @relation(fields: [incidentId], references: [id], onDelete: Restrict)

  receivedAt      DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([tenantId, sourceId, externalEventId])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, severity])
}


// Identite machine d'une source Wazuh.
// Le secret brut n'est jamais conserve en base.
model WazuhConnector {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  name       String
  sourceId   String
  secretHash String   @db.VarChar(64)

  isActive   Boolean  @default(true)
  revokedAt  DateTime?
  lastUsedAt DateTime?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([tenantId, sourceId])
  @@index([tenantId, isActive])
}


// V0.3 — bibliothèque commune, jamais directement reliée aux preuves privées.
model SharedThreat {
  id             String   @id @default(uuid())
  indicatorType  IoCType
  indicatorValue String
  title          String
  mitigation     String
  publishedAt    DateTime @default(now())
  revokedAt      DateTime?
  publishedById  String

  submissions    ThreatSubmission[]
  incidentLinks  IncidentThreatLink[]

  @@unique([indicatorType, indicatorValue])
  @@index([revokedAt, publishedAt])
}

enum ThreatReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

// Une proposition est privée. Seule la version explicitement validée est publiée.
model ThreatSubmission {
  id                String             @id @default(uuid())
  tenantId          String
  sourceIoCId       String
  indicatorType     IoCType
  indicatorValue    String
  title             String
  mitigation        String
  status            ThreatReviewStatus @default(PENDING)
  submittedById     String
  reviewedById      String?
  reviewedAt        DateTime?
  publishedThreatId String?
  createdAt         DateTime           @default(now())

  tenant           Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  publishedThreat SharedThreat? @relation(fields: [publishedThreatId], references: [id], onDelete: Restrict)

  @@index([tenantId, status, createdAt])
  @@index([status, createdAt])
}

// Une association reste strictement dans le périmètre du tenant.
model IncidentThreatLink {
  id         String   @id @default(uuid())
  tenantId   String
  incidentId String
  threatId   String
  linkedById String
  createdAt  DateTime @default(now())

  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  incident Incident     @relation(fields: [incidentId], references: [id], onDelete: Restrict)
  threat   SharedThreat @relation(fields: [threatId], references: [id], onDelete: Restrict)

  @@unique([tenantId, incidentId, threatId])
  @@index([tenantId, createdAt])
}
